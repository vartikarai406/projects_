# ==============================================================================
# AutoPilot AI — Environment Configuration Template
# Place actual secrets in your local .env file. Never commit real keys.
# ==============================================================================

# Application Security
AUTOPILOT_SECRET_KEY=autopilot-production-secret-change-this-in-production-32chars
DATABASE_URL=sqlite:///./autopilot.db
# For PostgreSQL: postgresql://autopilot_user:secretpass@localhost:5432/autopilot_db

# AI Model Provider Credentials (Optional: Built-in deterministic DAG planner runs with 0 keys!)
GEMINI_API_KEY=
OPENAI_API_KEY=
DEFAULT_PROVIDER=auto

# External Research Tool Credentials (Optional: Safe mock search runs if blank)
TAVILY_API_KEY=
SERPAPI_API_KEY=

# Execution Limits
MAX_TASKS_PER_WORKFLOW=20
DEFAULT_TASK_TIMEOUT_SECONDS=120
MAX_RETRIES_PER_TASK=3
RATE_LIMIT_PER_MINUTE=60
